{
  "name": "@local/dsh-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Issues, workers, and a derived PR board inside DeepSeek Harness.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc -p tsconfig.src.json",
    "typecheck:all": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "build:spike": "tsc -p tsconfig.spike.json",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "6.0.3"
  }
}
