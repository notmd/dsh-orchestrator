{
  "name": "@local/dsh-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Issues, workers, and a derived PR board inside DeepSeek Harness.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./dist/client/index.js"
  },
  "files": [
    "dist",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "locale"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc -p tsconfig.src.json",
    "typecheck:all": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json",
    "build:spike": "tsc -p tsconfig.spike.json",
    "verify": "npm run typecheck && npm test && npm run build",
    "build:client": "tsc -p tsconfig.client.json",
    "verify:all": "npm run typecheck:all && npm run build && npm run build:spike && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
